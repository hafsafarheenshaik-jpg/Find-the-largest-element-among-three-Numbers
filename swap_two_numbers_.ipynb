            "Enter first number: 5\n",
            "Enter second number: 6\n",
            "Before swapping:\n",
            "a = 5\n",
            "b = 6\n",
            "After swapping:\n",
            "a = 6\n",
            "b = 5\n"
          ]
        }
      ],
      "source": [
        "a =int(input(\"Enter first number: \"))\n",
        "b =int(input(\"Enter second number: \"))\n",
        "print(\"Before swapping:\")\n",
        "print(\"a =\", a)\n",
        "print(\"b =\", b)\n",
        "a, b = b, a\n",
        "print(\"After swapping:\")\n",
        "print(\"a =\", a)\n",
        "print(\"b =\", b)"
      ]
    }
  ]
